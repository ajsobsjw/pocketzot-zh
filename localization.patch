+    // resulting sometimes-wrong/sometimes-missing chip read worse than
+    // the unexplained default (dev-material/newgame-redesign.md).
+    armedEl = spectating ? null : el
+    setHighlight(el)
+    renderDock(itemByEl.get(el) ?? null)
+  }
