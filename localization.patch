+  let armedEl: HTMLElement | null = null
+  const itemByEl = new Map<HTMLElement, NgcItem>()
+
+  function setHighlight(el: HTMLElement | null): void {
+    if (highlightEl) highlightEl.classList.remove('ngv-sel')
+    highlightEl = el
+    if (el) {
