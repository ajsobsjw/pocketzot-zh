+    const titleEl = this.d.content().querySelector<HTMLElement>('.overlay-title')
+    const active = this.model.active
+    if (titleEl && active) {
+      titleEl.innerHTML = ''
+      titleEl.appendChild(document.createElement('span'))
+      this.paintTitle()
+    }
+  }
